VITE_APP_TITLE=智能ERP系统
VITE_API_BASE_URL=/api

# 生产环境完整版（所有模块都显示）
VITE_HIDDEN_MODULES=

# 平台管理（自营服务器部署启用，客户包不设置此值）
VITE_PLATFORM_ADMIN=true

# 客户升级部署（自营服务器启用；客户包不设置此值——客户环境不开放部署升级，防覆盖/删除用户数据）
VITE_DEPLOY_ADMIN=true

# 界面尺寸设置：功能状态=未完成，发布包一律过滤（本文件故意不设置该变量，仅 .env.development 开启）
# 将来功能定稿要发布时，把下面这行取消注释即可
# VITE_UI_SIZE_SETTINGS=true

# 语音调参（内部）：平台管理 → AI 默认规则 → 语音参数（等待指令时长）
# 自营服务器（8 服务器）启用；客户包 .env.customer 不设置该变量 = 整块不渲染
VITE_INTERNAL_VOICE_TUNING=true
