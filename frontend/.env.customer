VITE_APP_TITLE=智能ERP系统
VITE_API_BASE_URL=/api

# 需要隐藏的模块（逗号分隔），给客户部署时隐藏不需要的功能
# 可选值: acquisition(获客管理), crm(客户管理), sample(打样管理), subcontract(委外管理), finance(财务管理), platform(平台管理), ecommerce(电商平台)
# 2026-08-19: 获客管理(acquisition)已对客户部署包开放
# 2026-09-07: platform 从隐藏清单移除——121客户服务器开放"平台管理→客户管理(多租户)"，但通过 VITE_DEPLOY_ADMIN 不设置来关闭"客户升级部署"
# 2026-10-11: 电商平台(ecommerce)对客户部署包隐藏——功能已上线但真实凭据未接入，先不展示；放开 = 清掉 ecommerce 重新构建（数据库菜单与权限不动）
# 2026-11-09: 设备管理(device)对客户部署包隐藏——客户不需要该模块；放开 = 清掉 device 重新构建
VITE_HIDDEN_MODULES=ecommerce,device

# 隐藏的单据（2026-11-23 用户口径）：121 客户包一律不上「销售换货单 / 售后维修单」。
# 效果 = 侧边栏不出菜单、直接输 URL 跳工作台、单据页相关按钮/页签/打印类型下拉全部不渲染。
# 代码仍随包（全量包/其它服务器不受影响）；放开 = 删掉这一行重新构建。
VITE_HIDDEN_BILLS=SALE_EXCHANGE,SALE_REPAIR

# 电商平台路由物理剔除（2026-10-11）：与上一行菜单隐藏配套——路由/页面代码整组不进产物，输 URL 也不可达。
# 写法与平台管理构建期排除同口径（直接比较环境变量，构建器才能折叠剔除）。放开 = 两行都删掉重新构建。
VITE_HIDE_ECOMMERCE=true

# 设置中心入口整体隐藏（2026-10-11 用户口径：发布到121连设置中心也隐藏）
# 【2026-10-12 放开】：121 上要建租户给客户用，租户管理员也要进设置中心（改系统参数/编号规则等），
# 故删除 VITE_HIDDEN_SETTINGS 隐藏开关——入口恢复，权限仍按角色/菜单授权正常把关。
# VITE_HIDDEN_SETTINGS=true

# 平台管理：客户包开放"客户管理(多租户)"（自营服务器才有"客户升级部署"）
VITE_PLATFORM_ADMIN=true
# 不设置 VITE_DEPLOY_ADMIN —— 客户环境不开放部署升级（构建期排除路由/菜单，防覆盖/删除用户数据）

# 界面尺寸设置：功能状态=未完成，客户包一律过滤（本文件故意不设置该变量，仅 .env.development 开启）
# 将来功能定稿要给客户时，把下面这行取消注释即可
# VITE_UI_SIZE_SETTINGS=true

# 小助手语音三功能（🔊 语音提醒 / 🎧 语音唤醒 / ⚡ 语音直发）
# 2026-10-10 用户口径「除平台管理→客户部署升级外，其它都必须一样」→ 客户包不再关闭该功能。
# 保持不设置（＝undefined）即与全量包一致；如需单独关闭，取消下面一行注释即可。
# VITE_VOICE_FEATURES=false

# 小助手「界面新功能」开关
# 2026-10-10 同上：客户包不再走旧界面，保持不设置（＝与全量包一致，使用新版渲染）。
# VITE_ASSISTANT_UI_V2=false

