# =====================================================
# 智能ERP系统 - 环境变量配置模板
# 部署时复制为 .env 并填写实际值
# =====================================================

# ----- License 授权配置（供应商签发后告知客户）-----
# RSA 公钥（Base64，从供应商获取，用于校验 license.lic 签名）
ERP_LICENSE_PUBLIC_KEY=

# ----- JWT 密钥（生产环境必须修改，建议32位随机字符串）-----
# 可用 openssl rand -base64 32 生成
ERP_JWT_SECRET=

# ----- 数据库配置 -----
# 必填：数据库密码。docker-compose 启动时会校验该变量，未设置直接报错（不再内置默认密码）
POSTGRES_PASSWORD=
# 以下可选，默认值已适配 docker-compose
# ERP_DB_URL=jdbc:postgresql://postgres:5432/erp_db
# ERP_DB_USERNAME=erp_user

# ----- Redis 配置（可选，默认值已适配 docker-compose）-----
# ERP_REDIS_HOST=redis
# ERP_REDIS_PORT=6379
# ERP_REDIS_PASSWORD=
