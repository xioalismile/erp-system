{
  "name": "smart-erp-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/gen-page-actions.cjs && vite",
    "build": "node scripts/gen-page-actions.cjs && vite build",
    "build:customer": "node scripts/gen-page-actions.cjs && vite build --mode customer",
    "build:full": "node scripts/gen-page-actions.cjs && vite build --mode production",
    "scan-page-actions": "node scripts/gen-page-actions.cjs",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,vue}\"",
    "check:dropdown": "node scripts/check-dropdown-fields.cjs",
    "check:relations": "node scripts/check-push-relations.cjs",
    "check:capabilities": "node scripts/check-bill-capabilities.cjs",
    "check:permissions": "node scripts/check-permissions.cjs",
    "lint:fix": "eslint \"src/**/*.{js,vue}\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke:prepare": "node tests/smoke/prepare.mjs",
    "test:smoke:seed-chain": "node tests/smoke/seed-bill-chain.mjs",
    "test:smoke:seed-chain:cleanup": "node tests/smoke/seed-bill-chain.mjs --cleanup",
    "test:smoke:coverage": "node tests/smoke/menu-coverage.mjs",
    "test:smoke:cleanup-loop": "node tests/smoke/cleanup-loop-docs.mjs",
    "test:smoke:prepare:dry": "node tests/smoke/prepare.mjs --dry-run",
    "test:smoke:cleanup": "node tests/smoke/prepare.mjs --cleanup",
    "test:smoke:env": "node tests/smoke/smoke-env.mjs",
    "test:smoke": "playwright test --config=playwright.smoke.config.js",
    "test:smoke:login": "playwright test --config=playwright.smoke.config.js 01-login --reporter=list",
    "test:smoke:isolation": "playwright test --config=playwright.smoke.config.js 02-isolation --reporter=list",
    "test:smoke:loop": "playwright test --config=playwright.smoke.config.js 03-e2e-loop --reporter=list",
    "test:smoke:pages": "playwright test --config=playwright.smoke.config.js 05-pages --reporter=list",
    "test:smoke:gradual": "playwright test --config=playwright.smoke.config.js 06-gradual --reporter=list"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "axios": "^1.6.8",
    "dompurify": "^3.4.12",
    "echarts": "^5.5.0",
    "element-plus": "^2.7.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "allure-commandline": "^2.43.0",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.10.0",
    "form-data": "^4.0.6",
    "sass": "^1.77.0",
    "terser": "^5.49.0",
    "vite": "^5.2.0",
    "vitest": "^4.1.10",
    "xlsx": "^0.18.5"
  }
}
