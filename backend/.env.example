# ============================================================
# 智能ERP后端环境变量配置模板
# 使用方法：
#   1. 复制本文件为 .env （.env 已被 .gitignore 排除）
#   2. 修改下面的值为生产环境真实配置
#   3. 使用 run.ps1 启动后端，会自动加载 .env 文件
# ============================================================

# === 数据库配置 (PostgreSQL) ===
ERP_DB_URL=jdbc:postgresql://localhost:5432/erp_db
ERP_DB_USERNAME=erp_user
ERP_DB_PASSWORD=Erp@2026

# === Redis配置 ===
ERP_REDIS_HOST=localhost
ERP_REDIS_PORT=6379
ERP_REDIS_PASSWORD=

# === JWT 密钥配置 ===
# 【推荐】留空：后端首次启动会在进程工作目录自动生成 erp-jwt-secret.key（48 字节随机密钥）并复用，
#         无需人工维护；请勿删除该文件（删除 = 全部用户重新登录）。
# 如需自行指定（多节点/多实例必须共用同一密钥时）：
#   PowerShell: $b=New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   Linux/Mac : openssl rand -base64 48
# 严禁使用历史公开默认值 DevLocalFixedJwtSecretKey_Erp2026_DoNotChange —— 检测到会直接拒绝启动。
ERP_JWT_SECRET=
# 密钥文件路径（可选，默认=进程工作目录下的 erp-jwt-secret.key）
# ERP_JWT_SECRET_FILE=C:\smart-erp\backend\erp-jwt-secret.key
# Token 有效期（毫秒），默认 24 小时 = 86400000
ERP_JWT_EXPIRATION=86400000

# === AI 接口密钥 ===
# 通义千问（阿里云百炼，有免费额度）
QWEN_API_KEY=
# DeepSeek（价格极低）
DEEPSEEK_API_KEY=
