VITE_APP_TITLE=智能ERP系统
VITE_API_BASE_URL=/api

# 开发环境：显示所有模块
VITE_HIDDEN_MODULES=

# 平台管理（本地开发启用，客户包不设置此值）
VITE_PLATFORM_ADMIN=true

# 客户升级部署（本地开发启用；客户包不设置此值）
VITE_DEPLOY_ADMIN=true

# 界面尺寸设置（功能状态：未完成，仅本地开发可见）
# true = 设置中心 → 自定义 → 界面尺寸设置 可见可测；发布包（.env.production / .env.customer）一律不设置此变量
VITE_UI_SIZE_SETTINGS=true

# 语音调参（内部）：平台管理 → AI 默认规则 → 语音参数（等待指令时长）
# 只在我们自己的部署里出现；客户包（.env.customer）不设置此变量 = 整块不渲染
VITE_INTERNAL_VOICE_TUNING=true
