# 服务器配置
PORT=3005
ERP_API_BASE=http://localhost:8080/api

# ERP 后端登录账号（采集服务调用 ERP API 时使用）
# 默认 admin/admin123，与前端默认登录账号一致
# 生产环境建议创建专用的采集服务账号并设置强密码
ERP_AUTH_USERNAME=admin
ERP_AUTH_PASSWORD=admin123

# 采集配置
HEADLESS=false
# 慢动作（毫秒）：仅用于人工观察自动化过程，正常必须为 0。
# 开着会让每次点击/按键硬等该毫秒数（实测 500 时：一次点击 2.1 秒、输入 1 个字符 1 秒），
# 登录页的远程投屏交互会明显发卡。
SLOW_MO=0
DEFAULT_TIMEOUT=30000
# 翻页 / 关键词之间的间隔（毫秒）。2026-09-16 由 3000 调整为 8000（企查查按 IP+账号限流）
CAPTURE_INTERVAL=8000
# 公司之间的采集间隔（毫秒）。2026-09-16 新增：逐家抓详情是撞限流主因
CAPTURE_COMPANY_INTERVAL=4000

# 采集任务浏览器是否无头（默认 true = 不在桌面弹窗、不会被误关）
# 说明：服务部署到服务器后没人能进服务器桌面操作/关闭窗口，窗口一旦被关，采集立即失败
#      （失败原因形如 page.$: Target page, context or browser has been closed）。
# 企查查/天眼查/风鸟采集已实测无头可用。（爱企查已下线：百度反自动化硬拦截，无法稳定通过）
# 排查问题时可临时设为 false，把采集窗口放回桌面观察。
CAPTURE_HEADLESS=true

# 登录任务浏览器是否无头（默认 false = 可见窗口）
# 登录要用户扫码 / 输手机验证码，可见窗口便于直接操作；服务器无人值守（窗口起不来）时设 true，
# 改用登录页右侧的「服务器浏览器画面」（实时投屏 + 原生键鼠）完成登录。
LOGIN_HEADLESS=false

# 截图存储
SCREENSHOT_DIR=./screenshots

# 登录流程结束后浏览器保活时长（毫秒，默认 300000 = 5 分钟，下限 60000）
# 用途：登录成功/失败后浏览器不立即关闭，这段时间「服务器浏览器画面」仍可看可操作
#      （处理风控页/验证码/弹窗），到点自动关闭；用户也可在页面点「关闭浏览器」立即关闭。
LOGIN_KEEP_ALIVE_MS=300000

# 企查查配置
QCC_LOGIN_URL=https://www.qcc.com/weblogin
QCC_SEARCH_URL=https://www.qcc.com/web/search

# 风鸟配置
FNB_HEADLESS=false
